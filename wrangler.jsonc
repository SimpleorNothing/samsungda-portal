{
  "name": "samsungda-portal",
  "compatibility_date": "2026-05-23",
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Run the Worker before serving static assets so the password gate can
    // protect "/" too. Without this, Cloudflare serves public/index.html
    // directly and the Worker (and its gate) never runs for the home page.
    "run_worker_first": true
  },
  // 배포 시각/버전을 런타임에서 읽어 "마지막 업데이트" 배지에 사용한다.
  // (런타임에 git이 없는 Worker 환경에서도 정확한 최신 배포 시각을 보장.)
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "BACKEND_UPSTREAM": "https://web-production-aeaba.up.railway.app",
    // 산하 도구 직접 프록시 upstream — 포털이 report-site를 거치지 않고 곧장 전달한다.
    "US10Y_UPSTREAM": "https://us10y-production.up.railway.app",
    "WEBAUTO_UPSTREAM": "https://website-automation.cw120-park.workers.dev"
  },
  "r2_buckets": [
    { "binding": "RESEARCH", "bucket_name": "samsungda-research" }
  ]
  // 접속 로그(/__logs)를 켜려면 D1 데이터베이스를 만든 뒤 아래 블록의 주석을
  // 풀고 database_id를 채워넣고 배포한다(테이블은 첫 접속 시 자동 생성).
  // 바인딩이 없으면 로깅은 자동으로 비활성화되며 사이트는 정상 동작한다.
  //   wrangler d1 create samsungda-access-logs
  //
  // "d1_databases": [
  //   {
  //     "binding": "ACCESS_LOG",
  //     "database_name": "samsungda-access-logs",
  //     "database_id": "<여기에 wrangler가 출력한 database_id>"
  //   }
  // ]
}
