{
  "name": "samsungda-portal",
  "compatibility_date": "2026-05-23",
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "BACKEND_UPSTREAM": "https://web-production-aeaba.up.railway.app"
  },
  "r2_buckets": [
    { "binding": "RESEARCH", "bucket_name": "samsungda-research" }
  ]
}
