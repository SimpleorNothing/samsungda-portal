# Local dev secrets for `wrangler dev` (copy to .dev.vars, which is gitignored).
# Optional fallback password to delete legacy research files that were uploaded
# before per-file delete passwords existed. New uploads no longer need this.
UPLOAD_TOKEN=change-me
# Site access password. When set, every page asks for this password once and
# then remembers the visitor via a long-lived cookie. Leave unset to disable.
SITE_PASSWORD=change-me
